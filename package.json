{
  "name": "movies-reservation-app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "start": "node dist/index.js",
    "server": "tsx watch src/index.ts",
    "client": "cd client && npm run dev",
    "preview": "vite preview",
    "migrate": "drizzle-kit generate",
    "push": "drizzle-kit push",
    "drop": "drizzle-kit drop",
    "studio": "drizzle-kit studio",
    "stripe:listen": "stripe listen --forward-to http://localhost:3000/stripe/webhook",
    "stripe:secret": "stripe listen --forward-to http://localhost:3000/stripe/webhook --print-secret",
    "stripe:trigger:complete": "stripe trigger checkout.session.completed",
    "stripe:trigger:cancel": "stripe trigger checkout.session.expired",
    "dev:all": "concurrently \"npm run dev\" \"npm run stripe:listen\" \"npm run studio\""
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "express": "^4.1.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "nodemailer": "^7.0.5",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "redis": "^5.8.3",
    "sequelize": "^6.37.7",
    "stripe": "^18.3.0",
    "validator": "^13.15.15",
    "winston": "^3.18.3",
    "xss-clean": "^0.1.4",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.3",
    "@types/pg": "^8.15.5",
    "@types/redis": "^4.0.10",
    "@types/winston": "^2.4.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
