{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "allowJs": true, // <--- allow importing .js
    "checkJs": false // <--- don’t type-check .js
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "exclude": [
    "dist",
    "public",
    "vite.config.js",
    "webpack.config.js",
    "drizzle.config.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ]
}
